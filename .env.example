PORT=3000
# URL pública del sitio (back_urls y webhook de Mercado Pago). En producción: https://tudominio.com
SITE_URL=http://localhost:3000
# Mercado Pago: https://www.mercadopago.com.ar/developers  (credenciales de PRUEBA primero)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Clave secreta del webhook (Tus integraciones > Webhooks). Obligatoria en producción.
MERCADOPAGO_WEBHOOK_SECRET=
# Firma de las sesiones del panel /admin. Generala con: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Emails a clientes desde la casilla de Hostinger (sin esto no se envían, la tienda funciona igual)
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# En Vercel se cargan solas al conectar Storage (Upstash Redis y Blob):
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (o KV_REST_API_URL / KV_REST_API_TOKEN) y BLOB_READ_WRITE_TOKEN
